# Base URL for the mobile app API (frontend)
NEXT_PUBLIC_API_BASE_URL=https://servi.tail31979d.ts.net/titanium/api

# Allowed CORS origins for the API server (comma-separated)
ALLOWED_ORIGINS=https://servi.tail31979d.ts.net,capacitor://localhost,http://localhost

# PostgreSQL connection (server)
DATABASE_HOST=localhost
DATABASE_PORT=54322
DATABASE_NAME=titanium
DATABASE_USER=titanium
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Android release signing (used by Gradle)
FORTIXAM_STORE_FILE=../fortixam.keystore
FORTIXAM_STORE_PASSWORD=CHANGE_ME_STORE_PASSWORD
FORTIXAM_KEY_ALIAS=fortixam
FORTIXAM_KEY_PASSWORD=CHANGE_ME_KEY_PASSWORD
