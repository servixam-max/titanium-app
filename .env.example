# FORTIXAM v8 — variables de entorno del servidor web
# Copia este archivo a .env y ajusta los valores.

# ── PostgreSQL ────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=titanium
DATABASE_USER=titanium
DATABASE_PASSWORD=cambia-esto
# "true" solo si la BD es remota con SSL (p. ej. Supabase, Neon)
DATABASE_SSL=false

# ── Autenticación JWT ──────────────────────────────────────
# Genera secretos fuertes con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo

# ── Web ────────────────────────────────────────────────────
# Puerto del servidor standalone / docker compose
PORT=3000
HOSTNAME=0.0.0.0

# Prefijo de assets si sirves la PWA bajo un subpath (opcional)
# NEXT_PUBLIC_ASSET_PREFIX=/fortixam

# Puerto publicado por docker compose (host)
WEB_PORT=3000

# ── APK / OTA ─────────────────────────────────────────────
# El APK habla con la API del servidor web cuando hay conexión.
# Configura aquí la URL pública de tu despliegue para el OTA server.
# FORTIXAM_API_URL=https://tu-dominio.com