{
  "appId": "com.servixam.titanium",
  "appName": "FORTIXAM",
  "webDir": "dist-apk",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": []
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#05090C",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#05090C"
    }
  }
}
