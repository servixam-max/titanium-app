{
  "appId": "com.servixam.titanium",
  "appName": "FORTIXAM",
  "webDir": "dist-apk",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "http://192.168.*:*",
      "http://100.*:*",
      "http://10.0.2.2:*",
      "https://*.servixam.app",
      "https://*.tail31979d.ts.net",
      "http://localhost:*",
      "https://accounts.google.com",
      "https://appleid.apple.com"
    ]
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#05090C",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#05090C"
    }
  }
}
