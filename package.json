{
  "name": "titanium-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/generate-sw.js",
    "build:apk": "cp next.config.apk.mjs next.config.mjs && npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk:clean": "cp next.config.apk.mjs next.config.mjs && npm run build && npx cap sync android && cd android && ./gradlew clean assembleDebug",
    "build:apk:signed": "cp next.config.apk.mjs next.config.mjs && npm run build && npx cap sync android && cd android && ./gradlew clean assembleRelease",
    "sync:android": "npx cap sync android",
    "open:android": "npx cap open android",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dexie": "^4.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "^16.3.3",
    "pg": "^8.21.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
