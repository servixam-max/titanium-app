{
  "name": "titanium-app",
  "version": "8.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "build:apk": "BUILD_MODE=apk next build && node scripts/generate-sw.js dist-apk && npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:apk:clean": "BUILD_MODE=apk next build && node scripts/generate-sw.js dist-apk && npx cap sync android && cd android && ./gradlew clean assembleRelease",
    "build:apk:debug": "BUILD_MODE=apk next build && node scripts/generate-sw.js dist-apk && npx cap sync android && cd android && ./gradlew assembleDebug",
    "sync:android": "npx cap sync android",
    "open:android": "npx cap open android",
    "release": "node scripts/release.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@gsap/react": "^2.1.2",
    "atropos": "^2.0.2",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dexie": "^4.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "next": "^16.3.3",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^26.0.0",
    "postcss": "^8",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.0.9"
  }
}
